name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Show Swift toolchain
        run: swift --version
      - name: Build, test, and validate
        run: make check
      - name: Build development app bundle
        run: make app
